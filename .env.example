# ----------------------------------------------------------------------------
# Mini Techies environment variables
# Copy to `.env.local` and fill in values as needed.
# ----------------------------------------------------------------------------

# Privacy-friendly analytics (Plausible). Set to your domain to enable.
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mini-techies.ca

# --- Database (Neon / Vercel Postgres) --------------------------------------
# Provisioned automatically when Neon is connected to the Vercel project.
# DATABASE_URL=postgresql://...

# --- Admin panel ------------------------------------------------------------
# Password required to view waitlist signups at /admin
# ADMIN_PASSWORD=choose-a-strong-password
# Optional separate signing secret for the admin session cookie
# ADMIN_SESSION_SECRET=another-long-random-string

# --- Optional waitlist side-channels ----------------------------------------

# Option A: POST each signup to a webhook (Google Sheet, Zapier, Make, CRM...)
# WAITLIST_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Option B: Email notification via Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# WAITLIST_FROM_EMAIL=waitlist@mini-techies.ca
# WAITLIST_NOTIFY_EMAIL=info@mini-techies.ca
